PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/educonnect

# Firebase Admin Service Account Credentials (Backend only - NEVER share with client)
# Option 1: Absolute or relative path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Full JSON string content of the service account key (useful for cloud/container deployment)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
