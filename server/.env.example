PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/educonnect

# Firebase Admin Service Account Credentials (Backend only - NEVER share with client)
# Option 1: Absolute or relative path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Full JSON string content of the service account key (useful for cloud/container deployment)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# External API: Hopin Jobs & Events
HOPIN_API_BASE_URL=https://api.hopinjobs.com
HOPIN_API_TIMEOUT_MS=10000

# External API: Brabble Hackathons & Competitions
# Sign up at https://brabble.ai/dashboard to retrieve an API key
BRABBLE_API_KEY=
BRABBLE_API_BASE_URL=https://brabble.ai
BRABBLE_API_TIMEOUT_MS=10000

# External API: BodhDisha Scholarships & Courses
# Sign up at https://bodhdisha.com/api/register to retrieve an API key
BODHDISHA_API_KEY=
BODHDISHA_API_BASE_URL=https://bodhdisha.com/api/v1
BODHDISHA_API_TIMEOUT_MS=10000

# External API: Devpost Hackathons & Competitions
DEVPOST_API_BASE_URL=https://devpost.com
DEVPOST_API_TIMEOUT_MS=10000

# External API: Remotive Remote Jobs & Internships
REMOTIVE_API_BASE_URL=https://remotive.com
REMOTIVE_API_TIMEOUT_MS=10000

# External API: Arbeitnow Jobs & Apprenticeships
ARBEITNOW_API_BASE_URL=https://www.arbeitnow.com
ARBEITNOW_API_TIMEOUT_MS=10000

# Automated External Opportunity Synchronization Scheduler
# Set SYNC_SCHEDULER_ENABLED=false to disable automated periodic sync (e.g. for testing or offline development)
SYNC_SCHEDULER_ENABLED=true
# Cron schedule expression for automated synchronization (Default: every 6 hours -> "0 */6 * * *")
SYNC_SCHEDULE=0 */6 * * *

# Resume Storage, GridFS & Intelligence Configuration (Batch 6)
# Maximum allowed file size for resume uploads in bytes (Default: 5242880 = 5 MB)
RESUME_MAX_FILE_SIZE=5242880
# Backend-enforced replacement cooldown interval in days (Default: 30)
RESUME_COOLDOWN_DAYS=30




