{
  "name": "educonnect",
  "version": "1.0.0",
  "description": "EduConnect - Unified Student Opportunity Platform",
  "scripts": {
    "setup": "npm install && npm --prefix server install && npm --prefix client install",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm --prefix server start\" \"npm --prefix client start\"",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "test:server": "npm --prefix server test",
    "test:b4": "npm --prefix server run test:b4",
    "test:b5": "npm --prefix server run test:b5",
    "test:b6": "npm --prefix server run test:b6",
    "test:analytics": "npm --prefix server run test:analytics",
    "test:p8": "npm --prefix server run test:p8",
    "test:p9": "npm --prefix server run test:p9",
    "test:p9_5": "npm --prefix server run test:p9_5",
    "test:p10": "npm --prefix server run test:p10",
    "test:audit": "npm --prefix server run test:audit",
    "train:ml": "npm --prefix server run train:ml",
    "audit:ml-data": "npm --prefix server run audit:ml-data",
    "provision:admin": "node server/src/scripts/provisionAdmin.js"
  },
  "keywords": [
    "mern",
    "student-opportunities",
    "recommendation-engine",
    "machine-learning"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
